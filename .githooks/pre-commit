#!/usr/bin/env bash
set -uo pipefail

# The kit's mechanical check, in the commit path. Green means a machine ran the suite.
# (The dev-ledger gate that used to live here was removed 2026-07-30; see scripts/check.sh.)
if [ -x scripts/check.sh ]; then
  if ! bash scripts/check.sh; then
    echo "✖ check failed — commit blocked." >&2
    exit 1
  fi
fi
