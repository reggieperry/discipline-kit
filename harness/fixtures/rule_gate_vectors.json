{
 "provenance": "Generated by the node-ignore bundled in Claude Code 2.1.286, driven by the generator below with Claude Code's rule-glob normalization: one trailing '/**' stripped from each glob, and a path starting with '..' or '/' never matching. 'globs' is every glob in claude-project/rules/*.md frontmatter at generation time plus edge patterns; 'matches' maps each glob to the indices of the 'paths' it matches; 'sets' are multi-glob cases. rule_gate_test.py replays every pair against reference/rule_gate.py's matcher. To regenerate: write this file's provenance, globs, paths and sets keys to inputs.json, put the generator lines in gen.cjs beside ignore_bundled.cjs, and run the command. ignore_bundled.cjs can be made two ways. From npm: the bundle is the npm package ignore at version 7.0.5 (it has the setupWindows export 7.0.5 added and lacks the class-negation change of 7.0.6; on 2026-09-30 it gave this file byte for byte). Run 'npm pack ignore@7.0.5', unpack it, and write ignore_bundled.cjs as the one line 'exports.ignore = require(\"./package/index.js\");', since the package exports the factory itself and the generator reads an 'ignore' property. From the binary: search it for the text Symbol.for(\"setupWindows\"); it ends a minified CommonJS factory, function(<a>,<b>){function <c>(e){return Array.isArray(e)?e:[e]} ... }, which is node-ignore. Save that function's text F as ignore_bundled.cjs in the form 'const f=F;const M={exports:{}};f(M.exports,M);exports.ignore=M.exports;'.",
 "command": "node gen.cjs < inputs.json > rule_gate_vectors.json",
 "generator": [
  "// Golden vectors for rule_gate.py's matcher, from the node-ignore bundled in Claude Code.",
  "// Usage: node gen.cjs < inputs.json > rule_gate_vectors.json, beside ignore_bundled.cjs.",
  "const fs = require('fs');",
  "const ignore = require('./ignore_bundled.cjs').ignore;",
  "const input = JSON.parse(fs.readFileSync(0, 'utf8'));",
  "// Claude Code's normalization of a rule's globs: one trailing \"/**\" stripped, empties dropped.",
  "const norm = (gs) => gs.map((g) => (g.endsWith('/**') ? g.slice(0, -3) : g)).filter((g) => g.length > 0);",
  "// Claude Code's guard before the matcher: a relative path starting with \"..\" or an absolute one never matches.",
  "const ignores = (gs, p) => (!p || p.startsWith('..') || p.startsWith('/')) ? false : ignore().add(norm(gs)).ignores(p);",
  "const matches = {};",
  "for (const g of input.globs) {",
  "  matches[g] = input.paths.map((p, i) => (ignores([g], p) ? i : -1)).filter((i) => i >= 0);",
  "}",
  "const sets = input.sets.map((s) => ({ globs: s.globs, path: s.path, match: ignores(s.globs, s.path) }));",
  "const src = fs.readFileSync(__filename, 'utf8').split('\\n');",
  "// One key per line, one glob per line, so a diff of a regenerated file reads by glob.",
  "const line = (k, v) => JSON.stringify(k) + ': ' + JSON.stringify(v);",
  "const out = [",
  "  line('provenance', input.provenance),",
  "  line('command', 'node gen.cjs < inputs.json > rule_gate_vectors.json'),",
  "  '\"generator\": [\\n  ' + src.map((l) => JSON.stringify(l)).join(',\\n  ') + '\\n ]',",
  "  '\"globs\": [\\n  ' + input.globs.map((g) => JSON.stringify(g)).join(',\\n  ') + '\\n ]',",
  "  '\"paths\": [\\n  ' + input.paths.map((p) => JSON.stringify(p)).join(',\\n  ') + '\\n ]',",
  "  '\"matches\": {\\n  ' + input.globs.map((g) => line(g, matches[g])).join(',\\n  ') + '\\n }',",
  "  '\"sets\": [\\n  ' + sets.map((s) => JSON.stringify(s)).join(',\\n  ') + '\\n ]',",
  "];",
  "process.stdout.write('{\\n ' + out.join(',\\n ') + '\\n}\\n');",
  ""
 ],
