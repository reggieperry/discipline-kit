#!/usr/bin/env python3
"""ledger/retire <id> <reason> <refuting-id> — move a defeated or superseded claim
off the live board to `ledger/trace/`, the ONE sanctioned removal from claims.jsonl.

VERBATIM-MOVE + SIDECAR (the immutability-safe form). The entry is taken out of
`ledger/claims.jsonl` and written to `ledger/trace/<id>.jsonl` in TWO lines:

  1. the original claim line, BYTE-IDENTICAL to what was committed, and
  2. a separate retirement record `{"retire_of": <id>, "trace_reason": <reason>,
     "retired_by": <refuting-id>, ...}` carrying the metadata.

This is the fix for the immutability defect: the audit holds every line ever
COMMITTED to claims.jsonl to be byte-identical now in live or trace, so rewriting the
moved entry (the old behavior — adding status/reason/pointer in place) necessarily
tripped `check_immutable` for any claim whose live form was committed in an EARLIER
commit, and forced the same-commit-only discipline that made the board accrete
superseded-in-place entries forever. Keeping the original verbatim and putting the
retirement metadata in a sibling record satisfies both immutability (the committed
line is present unchanged) and the trace check (the record supplies reason + pointer).
The pointer must resolve to an existing entry. Legacy in-place retired entries stay
valid — the audit reads either form.
"""
from __future__ import annotations

import datetime
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
LEDGER = ROOT / "ledger" / "claims.jsonl"
TRACE = ROOT / "ledger" / "trace"


def all_ids() -> set[str]:
    ids: set[str] = set()
    for f in [LEDGER] + (list(TRACE.glob("*.jsonl")) if TRACE.exists() else []):
        if not f.exists():
            continue
        for line in f.read_text().splitlines():
            if line.strip():
                try:
                    ids.add(json.loads(line).get("id"))
                except Exception:
                    pass
    return ids


def main() -> int:
    if len(sys.argv) != 4:
        print("usage: ledger/retire <id> <reason> <refuting-id>", file=sys.stderr)
        return 2
    eid, reason, ptr = sys.argv[1], sys.argv[2].strip(), sys.argv[3]
    if not reason:
        print("retire REJECTED: empty reason (trace_reason is required)", file=sys.stderr)
        return 1
    if ptr not in all_ids():
        print(f"retire REJECTED: pointer {ptr!r} does not resolve to any entry", file=sys.stderr)
        return 1

    lines = LEDGER.read_text().splitlines() if LEDGER.exists() else []
    kept, original_line = [], None
    for line in lines:
        if not line.strip():
            continue
        try:
            obj = json.loads(line)
        except Exception:
            kept.append(line)
            continue
        if obj.get("id") == eid and original_line is None:
            original_line = line  # keep the byte-identical committed line, NOT a re-serialization
        else:
            kept.append(line)

    if original_line is None:
        print(f"retire REJECTED: {eid!r} not found live in claims.jsonl", file=sys.stderr)
        return 1

    record = {
        "retire_of": eid,
        "ts": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "trace_reason": reason,
        "retired_by": ptr,
        "record": "retirement",
    }

    TRACE.mkdir(parents=True, exist_ok=True)
    LEDGER.write_text("".join(line + "\n" for line in kept), encoding="utf-8")
    with (TRACE / f"{eid}.jsonl").open("a", encoding="utf-8") as f:
        f.write(original_line + "\n")  # (1) the committed line, verbatim — satisfies immutability
        f.write(json.dumps(record, separators=(",", ":"), ensure_ascii=False) + "\n")  # (2) sidecar
    print(f"retired {eid} -> ledger/trace/{eid}.jsonl (verbatim + retirement record; "
          f"reason: {reason}; pointer: {ptr})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
