#!/usr/bin/env python3
"""ledger/red-proof — the mechanical court for the "observed red" disclosure.

Proves that a slice's NEW tests actually DETECT its implementation change: it builds a hybrid tree
(the implementation at BASE, the tests from HEAD), runs the named test command there, and asserts the
new tests FAIL against the old implementation. A test that passes without the diff is a tautology or a
green-by-weakening — red-proof fails it. It does NOT prove authoring order (that is testimony's job);
it proves *these tests detect this diff*.

    ledger/red-proof --test-cmd '<cmd that runs the new tests>' [--base <sha>] [--tests <path> ...]

BASE defaults to the merge-base with the upstream branch, else HEAD~1. TESTS default to the
test-looking paths in `git diff --name-only BASE..HEAD` (name contains 'test', 'Suite', or 'spec').
The command is scoped by the caller to the new tests, so a non-zero exit against the hybrid means at
least one new test failed — red confirmed. Emits a receipt line for the done-report:

    red-proof: <N> new test path(s) failed against base <sha8> (red confirmed)

Isolation: the hybrid is a throwaway `git worktree` at BASE, so the live working tree is never
touched. Wire as an OPTIONAL component of ledger/check.sh and a standing done-report line — a norm
earns blocking power only after a season of receipts. Exit 0 = red confirmed; 1 = NOT red
(tautological/weakened); 2 = setup error.
"""
from __future__ import annotations

import argparse
import subprocess
import sys
import tempfile
from pathlib import Path

TEST_HINTS = ("test", "Suite", "spec")


def git(root: Path, *args: str, check: bool = False) -> subprocess.CompletedProcess:
    return subprocess.run(["git", *args], cwd=root, capture_output=True, text=True,
                          check=check)


def resolve_base(root: Path, base: str | None) -> str | None:
    if base:
        r = git(root, "rev-parse", "--verify", base)
        return r.stdout.strip() if r.returncode == 0 else None
    mb = git(root, "merge-base", "HEAD", "@{u}")
    if mb.returncode == 0 and mb.stdout.strip():
        return mb.stdout.strip()
    r = git(root, "rev-parse", "--verify", "HEAD~1")
    return r.stdout.strip() if r.returncode == 0 else None


def derive_tests(root: Path, base: str) -> list[str]:
    r = git(root, "diff", "--name-only", f"{base}..HEAD")
    if r.returncode != 0:
        return []
    return [p for p in r.stdout.splitlines()
            if p.strip() and any(h in p for h in TEST_HINTS)]


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=".")
    ap.add_argument("--base", default=None, help="merge-base sha (default: merge-base with upstream, else HEAD~1)")
    ap.add_argument("--test-cmd", required=True, help="command that runs the NEW tests (scoped by the caller)")
    ap.add_argument("--tests", nargs="*", default=None, help="new test paths (default: derived from the diff)")
    args = ap.parse_args()
    root = Path(args.root).resolve()

    if git(root, "rev-parse", "--git-dir").returncode != 0:
        print("red-proof: not a git repository", file=sys.stderr)
        return 2
    base = resolve_base(root, args.base)
    if not base:
        print("red-proof: could not resolve a BASE (pass --base)", file=sys.stderr)
        return 2
    tests = args.tests if args.tests else derive_tests(root, base)
    if not tests:
        print("red-proof: no new test paths to prove (pass --tests, or none matched the diff)", file=sys.stderr)
        return 2

    with tempfile.TemporaryDirectory() as td:
        wt = Path(td) / "hybrid"
        add = git(root, "worktree", "add", "--detach", "--force", str(wt), base)
        if add.returncode != 0:
            print(f"red-proof: worktree add failed: {add.stderr.strip()}", file=sys.stderr)
            return 2
        try:
            # overlay HEAD's version of each new test onto the BASE tree
            overlaid = 0
            for path in tests:
                blob = git(root, "show", f"HEAD:{path}")
                if blob.returncode != 0:
                    continue  # deleted-at-HEAD test: nothing to overlay
                dst = wt / path
                dst.parent.mkdir(parents=True, exist_ok=True)
                dst.write_text(blob.stdout, encoding="utf-8")
                overlaid += 1
            if overlaid == 0:
                print("red-proof: none of the named tests exist at HEAD to overlay", file=sys.stderr)
                return 2
            # run the caller-scoped test command against the hybrid tree
            proc = subprocess.run(args.test_cmd, cwd=wt, shell=True,
                                  capture_output=True, text=True)
            red = proc.returncode != 0
        finally:
            git(root, "worktree", "remove", "--force", str(wt))

    verdict = "red confirmed" if red else "NOT red (tautological or green-by-weakening)"
    print(f"red-proof: {overlaid} new test path(s) run against base {base[:8]} "
          f"(command exited {proc.returncode}) — {verdict}")
    if not red:
        print("  the new tests PASS against the old implementation — they do not detect the diff.",
              file=sys.stderr)
    return 0 if red else 1


if __name__ == "__main__":
    sys.exit(main())
