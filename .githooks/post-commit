#!/usr/bin/env bash
# Post-commit: the dev-ledger signer (kit harness). The commit sha now exists, so write the `signed`
# entries the pre-commit gate queued for the checks that passed, and record their line-hashes so the
# forgery guard admits them. These land UNCOMMITTED and are committed with the next commit — the
# sha-timing seam. Never fails the commit (it has already happened); it only records.
set -uo pipefail
if [ -f ledger/gate.py ]; then
  python3 ledger/gate.py --post-commit || true
fi
